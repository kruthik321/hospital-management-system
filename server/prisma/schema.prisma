generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  users       User[]

  @@map("roles")
}

model User {
  id            Int               @id @default(autoincrement())
  email         String            @unique @db.VarChar(255)
  password      String            @db.VarChar(255)
  firstName     String            @map("first_name") @db.VarChar(100)
  lastName      String            @map("last_name") @db.VarChar(100)
  phone         String?           @db.VarChar(20)
  avatar        String?
  isActive      Boolean?          @default(true) @map("is_active")
  roleId        Int               @map("role_id")
  createdAt     DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  auditLogs     AuditLog[]
  doctor        Doctor?
  kids          KidProfile[]      @relation("ParentKids")
  notifications Notification[]
  nurse         Nurse?
  patient       Patient?
  pregnancy     PregnancyProfile? @relation("MotherPregnancy")
  staff         Staff?
  role          Role              @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([email], map: "idx_users_email")
  @@index([roleId], map: "idx_users_role")
  @@map("users")
}

model Patient {
  id               Int              @id @default(autoincrement())
  userId           Int              @unique @map("user_id")
  dateOfBirth      DateTime?        @map("date_of_birth") @db.Date
  gender           String?          @db.VarChar(20)
  bloodGroup       String?          @map("blood_group") @db.VarChar(10)
  address          String?
  city             String?          @db.VarChar(100)
  state            String?          @db.VarChar(100)
  zipCode          String?          @map("zip_code") @db.VarChar(20)
  emergencyContact String?          @map("emergency_contact") @db.VarChar(100)
  emergencyPhone   String?          @map("emergency_phone") @db.VarChar(20)
  allergies        String?
  createdAt        DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  admissions       Admission[]
  appointments     Appointment[]
  billing          Billing[]
  diagnoses        Diagnosis[]
  emergencyCases   EmergencyCase[]
  feedback         Feedback[]
  insurance        Insurance?
  labOrders        LabOrder[]
  medicalRecords   MedicalRecord[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prescriptions    Prescription[]
  roomAssignments  RoomAssignment[]
  vitals           Vital[]

  @@map("patients")
}

model Doctor {
  id              Int              @id @default(autoincrement())
  userId          Int              @unique @map("user_id")
  departmentId    Int?             @map("department_id")
  specialization  String?          @db.VarChar(100)
  qualification   String?          @db.VarChar(200)
  experience      Int?             @db.SmallInt
  consultationFee Decimal?         @map("consultation_fee") @db.Decimal(10, 2)
  licenseNumber   String?          @unique @map("license_number") @db.VarChar(50)
  bio             String?
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  appointments    Appointment[]
  diagnoses       Diagnosis[]
  schedules       DoctorSchedule[]
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feedback        Feedback[]
  labOrders       LabOrder[]
  prescriptions   Prescription[]

  @@index([departmentId], map: "idx_doctors_dept")
  @@index([specialization], map: "idx_doctors_spec")
  @@map("doctors")
}

model Nurse {
  id             Int         @id @default(autoincrement())
  userId         Int         @unique @map("user_id")
  departmentId   Int?        @map("department_id")
  shiftType      String?     @map("shift_type") @db.VarChar(20)
  qualification  String?     @db.VarChar(200)
  wardAssignment String?     @map("ward_assignment") @db.VarChar(100)
  createdAt      DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vitals         Vital[]

  @@map("nurses")
}

model Staff {
  id           Int         @id @default(autoincrement())
  userId       Int         @unique @map("user_id")
  designation  String?     @db.VarChar(100)
  departmentId Int?        @map("department_id")
  createdAt    DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("staff")
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?
  headOfDept  String?   @map("head_of_dept") @db.VarChar(100)
  phone       String?   @db.VarChar(20)
  floor       String?   @db.VarChar(50)
  isActive    Boolean?  @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  doctors     Doctor[]
  nurses      Nurse[]
  rooms       Room[]
  staff       Staff[]

  @@map("departments")
}

model Appointment {
  id              Int           @id @default(autoincrement())
  patientId       Int           @map("patient_id")
  doctorId        Int           @map("doctor_id")
  appointmentDate DateTime      @map("appointment_date") @db.Timestamp(6)
  timeSlot        String        @map("time_slot") @db.VarChar(20)
  status          String?       @default("SCHEDULED") @db.VarChar(20)
  type            String?       @default("CONSULTATION") @db.VarChar(20)
  reason          String?
  notes           String?
  createdAt       DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  doctor          Doctor        @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  billing         Billing?
  prescription    Prescription?

  @@index([appointmentDate], map: "idx_appointments_date")
  @@index([doctorId], map: "idx_appointments_doctor")
  @@index([patientId], map: "idx_appointments_patient")
  @@index([status], map: "idx_appointments_status")
  @@map("appointments")
}

model DoctorSchedule {
  id           Int       @id @default(autoincrement())
  doctorId     Int       @map("doctor_id")
  dayOfWeek    String    @map("day_of_week") @db.VarChar(20)
  startTime    String    @map("start_time") @db.VarChar(10)
  endTime      String    @map("end_time") @db.VarChar(10)
  slotDuration Int?      @default(30) @map("slot_duration")
  isActive     Boolean?  @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  doctor       Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([doctorId], map: "idx_schedules_doctor")
  @@map("doctor_schedules")
}

model Prescription {
  id             Int                @id @default(autoincrement())
  patientId      Int                @map("patient_id")
  doctorId       Int                @map("doctor_id")
  appointmentId  Int?               @unique @map("appointment_id")
  diagnosisNotes String?            @map("diagnosis_notes")
  instructions   String?
  followUpDate   DateTime?          @map("follow_up_date") @db.Date
  createdAt      DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  pharmacyOrders PharmacyOrder[]
  items          PrescriptionItem[]
  appointment    Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctor         Doctor             @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([doctorId], map: "idx_prescriptions_doctor")
  @@index([patientId], map: "idx_prescriptions_patient")
  @@map("prescriptions")
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int          @map("prescription_id")
  medicationId   Int          @map("medication_id")
  dosage         String       @db.VarChar(100)
  frequency      String       @db.VarChar(100)
  duration       String       @db.VarChar(100)
  instructions   String?
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)
  medication     Medication   @relation(fields: [medicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([prescriptionId], map: "idx_prescription_items")
  @@map("prescription_items")
}

model Medication {
  id                Int                @id @default(autoincrement())
  name              String             @db.VarChar(200)
  genericName       String?            @map("generic_name") @db.VarChar(200)
  category          String?            @db.VarChar(100)
  manufacturer      String?            @db.VarChar(200)
  dosageForm        String?            @map("dosage_form") @db.VarChar(50)
  strength          String?            @db.VarChar(50)
  price             Decimal?           @default(0) @db.Decimal(10, 2)
  description       String?
  sideEffects       String?            @map("side_effects")
  isActive          Boolean?           @default(true) @map("is_active")
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  inventory         Inventory[]
  prescriptionItems PrescriptionItem[]

  @@index([name], map: "idx_medications_name")
  @@map("medications")
}

model LabTest {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(200)
  category    String?    @db.VarChar(100)
  description String?
  cost        Decimal?   @default(0) @db.Decimal(10, 2)
  normalRange String?    @map("normal_range") @db.VarChar(100)
  unit        String?    @db.VarChar(50)
  isActive    Boolean?   @default(true) @map("is_active")
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  labOrders   LabOrder[]

  @@map("lab_tests")
}

model LabOrder {
  id        Int        @id @default(autoincrement())
  patientId Int        @map("patient_id")
  doctorId  Int        @map("doctor_id")
  labTestId Int        @map("lab_test_id")
  status    String?    @default("PENDING") @db.VarChar(20)
  priority  String?    @default("NORMAL") @db.VarChar(20)
  orderedAt DateTime?  @default(now()) @map("ordered_at") @db.Timestamp(6)
  createdAt DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  doctor    Doctor     @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labTest   LabTest    @relation(fields: [labTestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labReport LabReport?

  @@index([doctorId], map: "idx_lab_orders_doctor")
  @@index([patientId], map: "idx_lab_orders_patient")
  @@map("lab_orders")
}

model LabReport {
  id          Int       @id @default(autoincrement())
  labOrderId  Int       @unique @map("lab_order_id")
  result      String?
  resultValue String?   @map("result_value") @db.VarChar(100)
  remarks     String?
  filePath    String?   @map("file_path")
  reportedBy  String?   @map("reported_by") @db.VarChar(100)
  reportedAt  DateTime? @map("reported_at") @db.Timestamp(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  labOrder    LabOrder  @relation(fields: [labOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("lab_reports")
}

model MedicalRecord {
  id          Int       @id @default(autoincrement())
  patientId   Int       @map("patient_id")
  recordType  String    @map("record_type") @db.VarChar(50)
  title       String    @db.VarChar(200)
  description String?
  filePath    String?   @map("file_path")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patientId], map: "idx_medical_records_patient")
  @@map("medical_records")
}

model Vital {
  id               Int       @id @default(autoincrement())
  patientId        Int       @map("patient_id")
  nurseId          Int?      @map("nurse_id")
  bloodPressure    String?   @map("blood_pressure") @db.VarChar(20)
  heartRate        Int?      @map("heart_rate")
  temperature      Decimal?  @db.Decimal(4, 1)
  respiratoryRate  Int?      @map("respiratory_rate")
  oxygenSaturation Decimal?  @map("oxygen_saturation") @db.Decimal(5, 2)
  weight           Decimal?  @db.Decimal(5, 2)
  height           Decimal?  @db.Decimal(5, 2)
  notes            String?
  recordedAt       DateTime? @default(now()) @map("recorded_at") @db.Timestamp(6)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  nurse            Nurse?    @relation(fields: [nurseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([patientId], map: "idx_vitals_patient")
  @@map("vitals")
}

model Diagnosis {
  id             Int             @id @default(autoincrement())
  patientId      Int             @map("patient_id")
  doctorId       Int             @map("doctor_id")
  condition      String          @db.VarChar(200)
  description    String?
  severity       String?         @db.VarChar(20)
  icdCode        String?         @map("icd_code") @db.VarChar(20)
  diagnosedAt    DateTime?       @default(now()) @map("diagnosed_at") @db.Timestamp(6)
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  doctor         Doctor          @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  treatmentPlans TreatmentPlan[]

  @@index([patientId], map: "idx_diagnoses_patient")
  @@map("diagnoses")
}

model TreatmentPlan {
  id          Int       @id @default(autoincrement())
  diagnosisId Int       @map("diagnosis_id")
  planDetails String    @map("plan_details")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  status      String?   @default("ACTIVE") @db.VarChar(20)
  notes       String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([diagnosisId], map: "idx_treatment_plans_diagnosis")
  @@map("treatment_plans")
}

model Room {
  id           Int         @id @default(autoincrement())
  roomNumber   String      @unique @map("room_number") @db.VarChar(20)
  departmentId Int?        @map("department_id")
  type         String      @db.VarChar(30)
  floor        String?     @db.VarChar(20)
  charges      Decimal?    @default(0) @db.Decimal(10, 2)
  isActive     Boolean?    @default(true) @map("is_active")
  createdAt    DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  beds         Bed[]
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([departmentId], map: "idx_rooms_dept")
  @@map("rooms")
}

model Bed {
  id              Int              @id @default(autoincrement())
  roomId          Int              @map("room_id")
  bedNumber       String           @map("bed_number") @db.VarChar(20)
  isOccupied      Boolean?         @default(false) @map("is_occupied")
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roomAssignments RoomAssignment[]

  @@unique([roomId, bedNumber])
  @@map("beds")
}

model RoomAssignment {
  id           Int       @id @default(autoincrement())
  patientId    Int       @map("patient_id")
  bedId        Int       @map("bed_id")
  assignedAt   DateTime? @default(now()) @map("assigned_at") @db.Timestamp(6)
  dischargedAt DateTime? @map("discharged_at") @db.Timestamp(6)
  status       String?   @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  bed          Bed       @relation(fields: [bedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bedId], map: "idx_room_assign_bed")
  @@index([patientId], map: "idx_room_assign_patient")
  @@map("room_assignments")
}

model Admission {
  id        Int        @id @default(autoincrement())
  patientId Int        @map("patient_id")
  admitDate DateTime   @map("admit_date") @db.Timestamp(6)
  reason    String?
  status    String?    @default("ADMITTED") @db.VarChar(20)
  notes     String?
  createdAt DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discharge Discharge?

  @@index([patientId], map: "idx_admissions_patient")
  @@map("admissions")
}

model Discharge {
  id            Int       @id @default(autoincrement())
  admissionId   Int       @unique @map("admission_id")
  dischargeDate DateTime  @map("discharge_date") @db.Timestamp(6)
  summary       String?
  instructions  String?
  followUpDate  DateTime? @map("follow_up_date") @db.Date
  dischargedBy  String?   @map("discharged_by") @db.VarChar(100)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  admission     Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("discharges")
}

model Billing {
  id            Int           @id @default(autoincrement())
  patientId     Int           @map("patient_id")
  appointmentId Int?          @unique @map("appointment_id")
  totalAmount   Decimal?      @default(0) @map("total_amount") @db.Decimal(12, 2)
  discount      Decimal?      @default(0) @db.Decimal(12, 2)
  tax           Decimal?      @default(0) @db.Decimal(12, 2)
  netAmount     Decimal?      @default(0) @map("net_amount") @db.Decimal(12, 2)
  status        String?       @default("PENDING") @db.VarChar(20)
  dueDate       DateTime?     @map("due_date") @db.Date
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items         BillingItem[]
  payments      Payment[]

  @@index([patientId], map: "idx_billing_patient")
  @@index([status], map: "idx_billing_status")
  @@map("billing")
}

model BillingItem {
  id          Int       @id @default(autoincrement())
  billingId   Int       @map("billing_id")
  description String    @db.VarChar(200)
  category    String?   @db.VarChar(50)
  quantity    Int?      @default(1)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal   @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  billing     Billing   @relation(fields: [billingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([billingId], map: "idx_billing_items")
  @@map("billing_items")
}

model Payment {
  id            Int       @id @default(autoincrement())
  billingId     Int       @map("billing_id")
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String    @map("payment_method") @db.VarChar(20)
  transactionId String?   @map("transaction_id") @db.VarChar(100)
  status        String?   @default("COMPLETED") @db.VarChar(20)
  paidAt        DateTime? @default(now()) @map("paid_at") @db.Timestamp(6)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  billing       Billing   @relation(fields: [billingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([billingId], map: "idx_payments_billing")
  @@map("payments")
}

model Insurance {
  id           Int       @id @default(autoincrement())
  patientId    Int       @unique @map("patient_id")
  provider     String    @db.VarChar(200)
  policyNumber String    @map("policy_number") @db.VarChar(100)
  groupNumber  String?   @map("group_number") @db.VarChar(100)
  coverageType String?   @map("coverage_type") @db.VarChar(50)
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime  @map("valid_to") @db.Date
  maxCoverage  Decimal?  @map("max_coverage") @db.Decimal(12, 2)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("insurance")
}

model PharmacyOrder {
  id             Int          @id @default(autoincrement())
  prescriptionId Int          @map("prescription_id")
  status         String?      @default("PENDING") @db.VarChar(20)
  dispensedBy    String?      @map("dispensed_by") @db.VarChar(100)
  dispensedAt    DateTime?    @map("dispensed_at") @db.Timestamp(6)
  totalCost      Decimal?     @default(0) @map("total_cost") @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([prescriptionId], map: "idx_pharmacy_orders_rx")
  @@map("pharmacy_orders")
}

model Inventory {
  id           Int         @id @default(autoincrement())
  medicationId Int?        @map("medication_id")
  itemName     String      @map("item_name") @db.VarChar(200)
  category     String?     @db.VarChar(50)
  quantity     Int?        @default(0)
  unit         String?     @db.VarChar(50)
  reorderLevel Int?        @default(10) @map("reorder_level")
  supplier     String?     @db.VarChar(200)
  batchNumber  String?     @map("batch_number") @db.VarChar(100)
  expiryDate   DateTime?   @map("expiry_date") @db.Date
  costPerUnit  Decimal?    @default(0) @map("cost_per_unit") @db.Decimal(10, 2)
  createdAt    DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category], map: "idx_inventory_cat")
  @@index([medicationId], map: "idx_inventory_med")
  @@map("inventory")
}

model Equipment {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(200)
  category       String?   @db.VarChar(100)
  model          String?   @db.VarChar(200)
  serialNumber   String?   @unique @map("serial_number") @db.VarChar(100)
  purchaseDate   DateTime? @map("purchase_date") @db.Date
  warrantyExpiry DateTime? @map("warranty_expiry") @db.Date
  status         String?   @default("WORKING") @db.VarChar(20)
  location       String?   @db.VarChar(100)
  cost           Decimal?  @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("equipment")
}

model Feedback {
  id          Int       @id @default(autoincrement())
  patientId   Int       @map("patient_id")
  doctorId    Int?      @map("doctor_id")
  rating      Int
  comment     String?
  category    String?   @db.VarChar(50)
  isAnonymous Boolean?  @default(false) @map("is_anonymous")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  doctor      Doctor?   @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([doctorId], map: "idx_feedback_doctor")
  @@index([patientId], map: "idx_feedback_patient")
  @@map("feedback")
}

model FAQ {
  id        Int       @id @default(autoincrement())
  question  String
  answer    String
  category  String?   @db.VarChar(50)
  keywords  String?
  sortOrder Int?      @default(0) @map("sort_order")
  isActive  Boolean?  @default(true) @map("is_active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("faq")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String    @db.VarChar(200)
  message   String
  type      String?   @db.VarChar(50)
  isRead    Boolean?  @default(false) @map("is_read")
  link      String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([isRead], map: "idx_notifications_read")
  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

model SymptomDiseaseMap {
  id             Int       @id @default(autoincrement())
  symptom        String    @db.VarChar(100)
  disease        String    @db.VarChar(200)
  specialization String    @db.VarChar(100)
  probability    Decimal?  @default(0.5) @db.Decimal(3, 2)
  description    String?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([symptom], map: "idx_symptom_map")
  @@map("symptom_disease_map")
}

model EmergencyCase {
  id          Int       @id @default(autoincrement())
  patientId   Int?      @map("patient_id")
  description String
  severity    String    @db.VarChar(20)
  status      String?   @default("ACTIVE") @db.VarChar(20)
  arrivedAt   DateTime? @default(now()) @map("arrived_at") @db.Timestamp(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamp(6)
  assignedTo  String?   @map("assigned_to") @db.VarChar(100)
  notes       String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  patient     Patient?  @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_emergency_status")
  @@map("emergency_cases")
}

model AuditLog {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  action    String    @db.VarChar(20)
  tableName String    @map("table_name") @db.VarChar(100)
  recordId  Int?      @map("record_id")
  oldValues String?   @map("old_values")
  newValues String?   @map("new_values")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt], map: "idx_audit_date")
  @@index([tableName], map: "idx_audit_table")
  @@index([userId], map: "idx_audit_user")
  @@map("audit_log")
}

model KidProfile {
  id           Int              @id @default(autoincrement())
  parentId     Int              @map("parent_id")
  name         String           @db.VarChar(200)
  age          Int
  gender       String           @db.VarChar(20)
  weight       Decimal?         @db.Decimal(5, 2)
  height       Decimal?         @db.Decimal(5, 2)
  bloodGroup   String?          @map("blood_group") @db.VarChar(10)
  allergies    String?
  conditions   String?          @map("medical_conditions")
  createdAt    DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  parent       User             @relation("ParentKids", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vaccinations KidVaccination[]

  @@index([parentId], map: "idx_kid_profiles_parent")
  @@map("kid_profiles")
}

model Vaccination {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(200)
  description     String?
  recommendedAge  String           @map("recommended_age") @db.VarChar(50)
  category        String?          @default("GENERAL") @db.VarChar(20)
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  kidVaccinations KidVaccination[]

  @@map("vaccinations")
}

model KidVaccination {
  id               Int         @id @default(autoincrement())
  kidId            Int         @map("kid_id")
  vaccinationId    Int         @map("vaccination_id")
  status           String?     @default("PENDING") @db.VarChar(20)
  administeredDate DateTime?   @map("administered_date") @db.Timestamp(6)
  createdAt        DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  kid              KidProfile  @relation(fields: [kidId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vaccination      Vaccination @relation(fields: [vaccinationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([kidId, vaccinationId])
  @@map("kid_vaccinations")
}

model PregnancyProfile {
  id                   Int                   @id @default(autoincrement())
  motherId             Int                   @unique @map("mother_id")
  motherName           String                @map("mother_name") @db.VarChar(200)
  expectedDeliveryDate DateTime              @map("expected_delivery_date") @db.Timestamp(6)
  pregnancyWeek        Int?                  @default(1) @map("pregnancy_week")
  medicalHistory       String?               @map("medical_history")
  doctorId             Int?                  @map("doctor_id")
  createdAt            DateTime?             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime?             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  mother               User                  @relation("MotherPregnancy", fields: [motherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  symptomLogs          PregnancySymptomLog[]

  @@index([motherId], map: "idx_pregnancy_profiles_mother")
  @@map("pregnancy_profiles")
}

model PregnancySymptomLog {
  id        Int              @id @default(autoincrement())
  profileId Int              @map("profile_id")
  week      Int
  symptoms  String           @db.VarChar(500)
  severity  String           @db.VarChar(20)
  notes     String?
  loggedAt  DateTime?        @default(now()) @map("logged_at") @db.Timestamp(6)
  profile   PregnancyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([profileId], map: "idx_pregnancy_logs_profile")
  @@map("pregnancy_symptom_logs")
}

