flowchart TD
    classDef model fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
    classDef relation fill:#fff3e0,stroke:#e65100,stroke-width:2px;

    User["model User"]:::model
    Patient["model Patient"]:::model
    Appt["model Appointment"]:::model

    R1["One-to-One (@relation)"]:::relation
    R2["One-to-Many (@relation)"]:::relation

    User --> |"patient Patient?"| R1
    R1 --> |"user User @relation(fields: [userId], references: [id])"| Patient

    Patient --> |"appointments Appointment[]"| R2
    R2 --> |"patient Patient @relation(fields: [patientId], references: [id])"| Appt
